<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="BgColor">#0B0D10</Color>
    <Color x:Key="PanelColor">#12161B</Color>
    <Color x:Key="Panel2Color">#171C22</Color>
    <Color x:Key="LineColor">#232A33</Color>
    <Color x:Key="Line2Color">#2D3640</Color>
    <Color x:Key="TextColor">#E6EBF0</Color>
    <Color x:Key="DimColor">#8A96A3</Color>
    <Color x:Key="MuteColor">#5C6772</Color>
    <Color x:Key="RedColor">#FF3B3B</Color>
    <Color x:Key="GreenColor">#20D07A</Color>
    <Color x:Key="AmberColor">#FFB020</Color>
    <Color x:Key="BlueColor">#3AA0FF</Color>
    <Color x:Key="VioletColor">#9B7BFF</Color>
    <Color x:Key="AccentColor">#FF6A1A</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Panel2" Color="{StaticResource Panel2Color}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Line2" Color="{StaticResource Line2Color}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
    <SolidColorBrush x:Key="Mute" Color="{StaticResource MuteColor}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="Violet" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Input" Color="#0B0E12" />
    <SolidColorBrush x:Key="BlueSoft" Color="#293AA0FF" />
    <SolidColorBrush x:Key="AmberSoft" Color="#1FFFB020" />
    <SolidColorBrush x:Key="VioletSoft" Color="#299B7BFF" />
    <SolidColorBrush x:Key="RedSoft" Color="#24FF3B3B" />
    <SolidColorBrush x:Key="GreenSoft" Color="#2420D07A" />

    <LinearGradientBrush x:Key="RedGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E0262B" Offset="0" />
        <GradientStop Color="#A8141A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GreenGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#17B86A" Offset="0" />
        <GradientStop Color="#0C7F48" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6A1A" Offset="0" />
        <GradientStop Color="#FF2D55" Offset="1" />
    </LinearGradientBrush>
    <VisualBrush x:Key="DangerStripes" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
        <VisualBrush.Visual>
            <Canvas Width="20" Height="20" Background="#2A0808">
                <Path Data="M0,20 L20,0 L20,10 L10,20 Z M0,10 L10,0 L0,0 Z" Fill="#3A0D0D" />
            </Canvas>
        </VisualBrush.Visual>
    </VisualBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Text -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Dim}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Dim}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,20" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Containers -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="BtnBase" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Panel2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="hover" CornerRadius="8" Background="#0FFFFFFF" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="40" CenterY="20" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BtnBase}" />
    <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource RedGrad}" />
        <Setter Property="BorderBrush" Value="#FF5A5A" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource GreenGrad}" />
        <Setter Property="BorderBrush" Value="#3DF29A" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="BtnAmber" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource AmberSoft}" />
        <Setter Property="BorderBrush" Value="#99FFB020" />
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
    </Style>
    <Style x:Key="BtnBlue" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource BlueSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
        <Setter Property="Foreground" Value="#CFE6FF" />
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource DangerStripes}" />
        <Setter Property="BorderBrush" Value="{StaticResource Red}" />
        <Setter Property="Foreground" Value="#FFB3B3" />
    </Style>
    <Style x:Key="ToggleBtn" TargetType="ToggleButton" BasedOn="{StaticResource BtnBase}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource BlueSoft}" />
                <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
                <Setter Property="Foreground" Value="#CFE6FF" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SpeedBtn" TargetType="ToggleButton" BasedOn="{StaticResource BtnBase}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource VioletSoft}" />
                <Setter Property="BorderBrush" Value="{StaticResource Violet}" />
                <Setter Property="Foreground" Value="#E1D8FF" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LinkBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Key hint -->
    <Style x:Key="KeyHint" TargetType="Border">
        <Setter Property="Background" Value="#0C0F12" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KeyHintText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Input}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Blue}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Blue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{StaticResource Input}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="▾" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
                        <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="8"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360" Margin="0,4,0,0">
                                <ScrollViewer><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="track" Width="42" Height="24" CornerRadius="12" Background="#2A333D">
                        <Ellipse x:Name="knob" Width="18" Height="18" Fill="{StaticResource Dim}" HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Green}" />
                            <Setter TargetName="knob" Property="Fill" Value="White" />
                            <Setter TargetName="knob" Property="Margin" Value="21,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scrollbars -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#33FFFFFF" CornerRadius="4" Margin="1" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#33FFFFFF" CornerRadius="4" Margin="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Lists -->
    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="b" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#0AFFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Panel2}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
    </Style>
    <!-- Right-click menus use the light Windows menu, so their text must be dark. Menu item headers are drawn by a
         TextBlock that WPF generates inside the item's template, and the app-wide TextBlock style (light text) reaches
         it there while styles nested in the menu do not, so every menu item draws its header with its own TextBlock. -->
    <DataTemplate x:Key="MenuHeaderText">
        <TextBlock Text="{Binding}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Black" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="False">
                            <Setter Property="Foreground" Value="#FF8A8A8A" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="HeaderTemplate" Value="{StaticResource MenuHeaderText}" />
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="Black" />
    </Style>
</ResourceDictionary>
