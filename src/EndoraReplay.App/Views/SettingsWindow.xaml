<Window x:Class="EndoraReplay.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Endora Replay · Settings" Width="1180" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Text}" UseLayoutRounding="True" ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.RowSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,14">
                    <TextBlock Text="SETTINGS" Style="{StaticResource H1}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Sub}" Margin="0,2,0,0" />
                </StackPanel>
                <ListBox x:Name="Nav" Style="{StaticResource PlainList}" SelectionChanged="OnNavChanged" Margin="8,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="8" Padding="12,10" Margin="0,2" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="PageHost" Margin="28,22,28,22" />
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource BtnBase}" Padding="18,8" Margin="0,0,8,0" Click="OnCancel" />
                    <Button Content="Apply" Style="{StaticResource BtnBlue}" Padding="18,8" Margin="0,0,8,0" Click="OnApply" />
                    <Button Content="Save &amp; close" Style="{StaticResource BtnGreen}" Padding="18,8" Click="OnSaveClose" />
                </StackPanel>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Dim}" Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
