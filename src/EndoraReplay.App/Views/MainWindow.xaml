<Window x:Class="EndoraReplay.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Endora Replay" Width="1920" Height="1080" MinWidth="1366" MinHeight="768"
        WindowState="Maximized" Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}"
        Icon="/Assets/endora.ico" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#11151A" Offset="0" />
                    <GradientStop Color="#0D1014" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="16,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="/Assets/endora-mark.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="ENDORA REPLAY" FontWeight="Black" FontSize="15" />
                        <TextBlock x:Name="VersionText" Text="INSTANT REPLAY" Style="{StaticResource Label}" FontSize="9" />
                    </StackPanel>

                    <Border Style="{StaticResource Pill}" ToolTip="ATEM connection">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="AtemDot" Width="8" Height="8" Fill="{StaticResource Mute}" Margin="0,0,8,0" />
                            <TextBlock x:Name="AtemText" Text="ATEM —" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PGM" Style="{StaticResource Label}" Foreground="#FF8A8A" Margin="0,0,8,0" />
                            <TextBlock x:Name="PgmText" Text="—" Style="{StaticResource Mono}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="|" Foreground="{StaticResource Line2}" Margin="10,0" VerticalAlignment="Center" />
                            <TextBlock Text="PVW" Style="{StaticResource Label}" Foreground="#6FF0AE" Margin="0,0,8,0" />
                            <TextBlock x:Name="PvwText" Text="—" Style="{StaticResource Mono}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StateChip" Style="{StaticResource Pill}" Background="{StaticResource AmberSoft}" BorderBrush="#73FFB020">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource Amber}" Margin="0,0,8,0" />
                            <TextBlock x:Name="StateText" Text="DISCONNECTED" FontWeight="Black" FontSize="12" Foreground="{StaticResource Amber}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="RecPill" Style="{StaticResource Pill}" BorderBrush="#80FF3B3B">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="{StaticResource Red}" Margin="0,0,8,0" />
                            <TextBlock x:Name="RecText" Text="REC —" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" ToolTip="PC load: CPU, GPU, memory and network">
                        <StackPanel x:Name="Meters" Orientation="Horizontal" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="SESSION TC" Style="{StaticResource Label}" Margin="0,0,10,0" />
                    <TextBlock x:Name="TcText" Text="00:00:00:00" Style="{StaticResource Mono}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DISK" Style="{StaticResource Label}" Margin="0,0,8,0" />
                            <TextBlock x:Name="DiskText" Text="—" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="RemotePill" Click="OnOpenRemote" MinHeight="32" Padding="12,0" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RemoteDot" Width="8" Height="8" Fill="{StaticResource Blue}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="RemoteText" Text="Remote" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpdateBtn" Click="OnOpenUpdates" MinHeight="32" Padding="12,0" Margin="0,0,10,0" FontSize="12" Visibility="Collapsed" Style="{StaticResource BtnGreen}" Content="Update ready" />
                    <Button Click="OnOpenSettings" Width="34" Height="34" MinHeight="34" Padding="0" ToolTip="Settings (Ctrl+,)">
                        <TextBlock Text="⚙" FontSize="16" Foreground="{StaticResource Dim}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= BODY ================= -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition x:Name="ControlsRow" Height="140" />
                    <RowDefinition Height="12" />
                    <RowDefinition x:Name="TilesRow" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Monitors -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.17*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PreviewBorder" Grid.Column="0" Background="Black" BorderBrush="{StaticResource Green}" BorderThickness="2" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                            <Border x:Name="PreviewNoSignal" Visibility="Collapsed">
                                <Border.Background>
                                    <VisualBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                                        <VisualBrush.Visual>
                                            <Canvas Width="24" Height="24" Background="#101317"><Path Data="M0,24 L24,0 L24,12 L12,24 Z M0,12 L12,0 L0,0 Z" Fill="#14181D" /></Canvas>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.Background>
                                <TextBlock x:Name="PreviewNoSignalText" Text="NO SIGNAL" Foreground="{StaticResource Mute}" FontWeight="Black" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                            </Border>
                            <Border x:Name="PreviewTag" Background="{StaticResource Green}" CornerRadius="5" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                <TextBlock x:Name="PreviewTagText" Text="REPLAY PREVIEW · CAM 1" Foreground="#002" FontWeight="Black" FontSize="11" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                <Border x:Name="PreviewSimChip" Style="{StaticResource Chip}" Visibility="Collapsed" Background="#CC2B1F4D"><TextBlock Text="SIMULATED" FontSize="11" FontWeight="Bold" Foreground="#C5B6FF" /></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="PreviewFormat" Text="1080p50" Style="{StaticResource Mono}" FontSize="11" /></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="PreviewSpeed" Text="50% SLOW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Violet}" /></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="PreviewMode" Text="LIVE" FontSize="11" FontWeight="Bold" /></Border>
                            </StackPanel>
                            <Grid VerticalAlignment="Bottom" Margin="10">
                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Padding="12,6" Margin="0">
                                    <TextBlock x:Name="PreviewPos" Text="LIVE" Style="{StaticResource Mono}" FontSize="20" />
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Border Style="{StaticResource Chip}"><TextBlock x:Name="MarkInText" Text="IN —" FontSize="11" FontWeight="SemiBold" /></Border>
                                    <Border Style="{StaticResource Chip}"><TextBlock x:Name="MarkOutText" Text="OUT —" FontSize="11" FontWeight="SemiBold" /></Border>
                                    <Border Style="{StaticResource Chip}"><TextBlock x:Name="ArmedText" Text="NOTHING ARMED" FontSize="11" FontWeight="SemiBold" /></Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="Black" BorderBrush="{StaticResource Red}" BorderThickness="2" CornerRadius="10" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ProgramImage" Stretch="Uniform" />
                                <TextBlock x:Name="ProgramNone" Text="NO PROGRAM FEED&#x0a;assign one in Settings → Capture inputs" TextAlignment="Center" Foreground="{StaticResource Mute}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Red}" CornerRadius="5" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                    <TextBlock Text="PROGRAM · FINAL OUT" Foreground="White" FontWeight="Black" FontSize="11" />
                                </Border>
                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"><TextBlock x:Name="ProgramInfo" Text="—" FontSize="11" FontWeight="SemiBold" /></Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Background="Black" BorderBrush="#4B3F7A" BorderThickness="2" CornerRadius="10" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="OutImage" Stretch="Uniform" />
                                <Viewbox x:Name="OutBadgeHost" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border Background="{StaticResource Violet}" CornerRadius="5" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                    <TextBlock x:Name="OutTag" Text="REPLAY OUT → ATEM IN 8" Foreground="White" FontWeight="Black" FontSize="11" />
                                </Border>
                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"><TextBlock x:Name="OutReady" Text="—" FontSize="11" FontWeight="Bold" /></Border>
                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"><TextBlock x:Name="OutInfo" Text="—" FontSize="11" FontWeight="SemiBold" /></Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Timeline -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button x:Name="ControlsToggle" DockPanel.Dock="Right" Click="OnToggleControls" MinHeight="22" Padding="10,0" Margin="12,0,0,0" FontSize="11"
                                    Content="▾ Minimise controls" ToolTip="Minimise the button panel so the camera previews get bigger" />
                            <TextBlock x:Name="TimelineLabel" Text="ROLLING BUFFER · CAM 1" Style="{StaticResource Label}" />
                            <TextBlock x:Name="TimelineScale" Text="LIVE" Style="{StaticResource Mono}" Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border Height="42" CornerRadius="7" Background="#0A0C0F" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True"
                                MouseLeftButtonDown="OnTimelineClick" Cursor="Hand">
                            <Canvas x:Name="Timeline" ClipToBounds="True">
                                <Rectangle x:Name="TlBuffer" Height="40" Fill="#141920" />
                                <Rectangle x:Name="TlRange" Height="30" Canvas.Top="5" Fill="#383AA0FF" Stroke="{StaticResource Blue}" RadiusX="4" RadiusY="4" Visibility="Collapsed" />
                                <Rectangle x:Name="TlHead" Width="2" Height="40" Fill="White" />
                                <Rectangle x:Name="TlLive" Width="4" Height="40" Fill="{StaticResource Red}" />
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Controls, minimised: one compact row of the essential buttons -->
                <Border x:Name="CompactControls" Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="8" Visibility="Collapsed">
                    <UniformGrid Rows="1">
                        <Button Tag="Replay" Content="▶ REPLAY" Style="{StaticResource BtnRed}" Margin="0,0,6,0" />
                        <Button Tag="Live" Content="LIVE" Style="{StaticResource BtnGreen}" Margin="0,0,6,0" />
                        <Button Tag="Stop" Content="■ STOP" Margin="0,0,6,0" />
                        <Button Tag="MarkIn" Content="MARK IN" Style="{StaticResource BtnBlue}" Margin="0,0,6,0" />
                        <Button Tag="MarkOut" Content="MARK OUT" Style="{StaticResource BtnBlue}" Margin="0,0,6,0" />
                        <Button Tag="Speed100" Content="100%" Margin="0,0,6,0" />
                        <Button Tag="Speed50" Content="50%" Margin="0,0,6,0" />
                        <Button Tag="Speed25" Content="25%" Margin="0,0,6,0" />
                        <Button Tag="CancelAuto" Content="CANCEL AUTO" Style="{StaticResource BtnAmber}" Margin="0,0,6,0" />
                        <Button Tag="EmergencyOverride" Content="OVERRIDE" Style="{StaticResource BtnDanger}" />
                    </UniformGrid>
                </Border>

                <!-- Controls -->
                <Grid x:Name="FullControls" Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="430" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="12">
                        <UniformGrid Rows="2" Columns="4">
                            <Button Tag="MarkIn" Content="MARK IN" Style="{StaticResource BtnBlue}" Margin="0,0,8,8" />
                            <Button Tag="MarkOut" Content="MARK OUT" Style="{StaticResource BtnBlue}" Margin="0,0,8,8" />
                            <Button Tag="SaveClip" Content="SAVE CLIP" Margin="0,0,8,8" />
                            <Button Tag="Tag" Content="TAG" Margin="0,0,0,8" />
                            <Button x:Name="LiveModeBtn" Tag="LiveMode" Content="LIVE MODE" Margin="0,0,8,0" />
                            <Button x:Name="JogModeBtn" Tag="JogMode" Content="JOG MODE" Margin="0,0,8,0" />
                            <Button Tag="FrameBack" Content="◀◀ 1 FR" Margin="0,0,8,0" />
                            <Button Tag="FrameForward" Content="1 FR ▶▶" />
                        </UniformGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                        <StackPanel VerticalAlignment="Center">
                            <Grid x:Name="JogWheel" Width="104" Height="104" Background="Transparent" Cursor="SizeAll"
                                  MouseLeftButtonDown="OnJogDown" MouseMove="OnJogMove" MouseLeftButtonUp="OnJogUp" MouseWheel="OnJogWheel"
                                  ToolTip="Drag in a circle or use the mouse wheel to jog frames">
                                <Grid.RenderTransform><RotateTransform x:Name="JogRotate" CenterX="52" CenterY="52" /></Grid.RenderTransform>
                                <Ellipse Stroke="{StaticResource Line2}" StrokeThickness="2">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.5,0.4">
                                            <GradientStop Color="#2A323B" Offset="0" />
                                            <GradientStop Color="#0E1216" Offset="0.75" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Margin="13" Stroke="#3A4550" StrokeDashArray="2 2" />
                                <Ellipse Width="15" Height="15" Fill="#3A4550" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            </Grid>
                            <TextBlock Text="JOG / SHUTTLE" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="SPEED" Style="{StaticResource Label}" Margin="0,0,0,8" HorizontalAlignment="Left" />
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource Input}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,8,0,0">
                                <UniformGrid Columns="2">
                                    <ToggleButton x:Name="AutoReturnBtn" Content="Auto return" Style="{StaticResource ToggleBtn}" MinHeight="26" FontSize="11" Click="OnReturnMode" Tag="Automatic" />
                                    <ToggleButton x:Name="ManualReturnBtn" Content="Manual" Style="{StaticResource ToggleBtn}" MinHeight="26" FontSize="11" Click="OnReturnMode" Tag="Manual" />
                                </UniformGrid>
                            </Border>
                            <UniformGrid Columns="3">
                                <ToggleButton x:Name="Speed100Btn" Tag="Speed100" Content="100%" Style="{StaticResource SpeedBtn}" Margin="0,0,6,0" Click="OnActionToggle" />
                                <ToggleButton x:Name="Speed50Btn" Tag="Speed50" Content="50%" Style="{StaticResource SpeedBtn}" Margin="0,0,6,0" Click="OnActionToggle" />
                                <ToggleButton x:Name="Speed25Btn" Tag="Speed25" Content="25%" Style="{StaticResource SpeedBtn}" Click="OnActionToggle" />
                            </UniformGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource PanelBorder}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button x:Name="ScoreBtn" Grid.Row="3" Grid.ColumnSpan="5" Tag="Scoreboard" Content="SCOREBOARD" FontSize="12" Height="30" Margin="0,8,0,0" Visibility="Collapsed" />
                            <Button Grid.RowSpan="3" Tag="Replay" Content="▶ REPLAY" Style="{StaticResource BtnRed}" FontSize="17" />
                            <Button Grid.Column="2" Tag="Live" Content="LIVE" Style="{StaticResource BtnGreen}" />
                            <Button Grid.Column="4" Tag="Stop" Content="■ STOP" />
                            <Button Grid.Column="2" Grid.Row="2" Tag="CancelAuto" Content="CANCEL AUTO" Style="{StaticResource BtnAmber}" FontSize="12" />
                            <Button x:Name="OverrideBtn" Grid.Column="4" Grid.Row="2" Tag="EmergencyOverride" Content="OVERRIDE" Style="{StaticResource BtnDanger}" FontSize="11" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Input tiles -->
                <UniformGrid x:Name="Tiles" Grid.Row="6" Columns="8" SizeChanged="OnTilesSizeChanged" />
            </Grid>

            <!-- ================= SIDEBAR ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="230" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <StackPanel>
                        <DockPanel Margin="12,10">
                            <TextBlock Text="AUTOMATION" Style="{StaticResource Label}" />
                            <Border x:Name="AutoBadge" Style="{StaticResource Badge}" HorizontalAlignment="Right" Background="{StaticResource GreenSoft}">
                                <TextBlock x:Name="AutoBadgeText" Text="AUTO" FontSize="10" FontWeight="Black" Foreground="{StaticResource Green}" />
                            </Border>
                        </DockPanel>
                        <Rectangle Height="1" Fill="{StaticResource Line}" />
                        <WrapPanel x:Name="StateFlow" Margin="12,10,6,6" />
                        <TextBlock x:Name="AutoInfo" Margin="12,0,12,12" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" LineHeight="18" Text="—" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="12,10">
                            <TextBlock x:Name="ClipHeader" Text="CLIP LIBRARY" Style="{StaticResource Label}" />
                            <ComboBox x:Name="TagFilter" DockPanel.Dock="Right" Width="120" MinHeight="26" SelectionChanged="OnTagFilter" FontSize="11" />
                            <Button DockPanel.Dock="Right" Content="HIGHLIGHTS" Style="{StaticResource BtnBase}" Padding="8,3" Margin="0,0,6,0" FontSize="10" FontWeight="Bold"
                                    Click="OnClipHighlights" ToolTip="Arm the selected clips (or every clip shown) as one highlights package, oldest first, with the stinger between each. Then press REPLAY." />
                        </DockPanel>
                        <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Line}" />
                        <ListBox x:Name="ClipList" Style="{StaticResource PlainList}" SelectionMode="Extended" MouseDoubleClick="OnClipDoubleClick" ToolTip="Double-click to arm. Ctrl+click or Shift+click to select several.">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" BorderBrush="#1A2027" BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Armed}" Value="True">
                                                        <Setter Property="Background" Value="#12FFB020" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Border Width="72" Height="40" CornerRadius="5" BorderBrush="{StaticResource Line2}" BorderThickness="1" ClipToBounds="True" Background="Black" Margin="0,0,10,0">
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,6,0" />
                                                    <ItemsControl ItemsSource="{Binding Tags}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="9" Padding="7,1" Margin="0,0,4,0" Background="#26FF3B3B">
                                                                    <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold" Foreground="#FF8A8A" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border CornerRadius="5" Padding="6,1" Background="{StaticResource AmberSoft}" Visibility="{Binding ArmedVisibility}">
                                                        <TextBlock Text="ARMED" FontSize="10" FontWeight="Black" Foreground="{StaticResource Amber}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="OnClipMenuOpened">
                                    <MenuItem Header="Arm" Click="OnClipArm" />
                                    <MenuItem Header="Tag" Tag="TagMenu" />
                                    <MenuItem Header="Tag picker…" Click="OnClipTag" />
                                    <MenuItem Header="Queue" Click="OnClipQueue" />
                                    <MenuItem Header="Arm selected as highlights" Click="OnClipHighlights" />
                                    <Separator />
                                    <MenuItem Header="Delete" Click="OnClipDelete" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="12,10">
                            <TextBlock Text="EVENT LOG" Style="{StaticResource Label}" />
                            <TextBlock x:Name="DropText" Text="dropped —" Style="{StaticResource Mono}" Foreground="{StaticResource Dim}" FontSize="10" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Line}" />
                        <ListBox x:Name="LogList" Style="{StaticResource PlainList}" Margin="12,6" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,1" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}">
                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource Mute}" />
                                        <Run Text="{Binding Category, Mode=OneWay}" Foreground="{Binding Color, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text="{Binding Message, Mode=OneWay}" Foreground="#B7C2CC" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Alert banner -->
            <Border x:Name="AlertBanner" Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="18,10" CornerRadius="10"
                    Background="#E62A1214" BorderBrush="{StaticResource Red}" BorderThickness="1" Visibility="Collapsed" MaxWidth="1100">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear (F9)" Tag="ClearError" Margin="16,0,0,0" MinHeight="28" FontSize="11" x:Name="ClearErrorBtn" />
                    <TextBlock x:Name="AlertText" Foreground="#FFD0D0" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Tag picker -->
            <Border x:Name="TagPicker" Grid.ColumnSpan="3" Background="#B3000000" Visibility="Collapsed" MouseLeftButtonDown="OnTagPickerBackground">
                <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <StackPanel>
                        <TextBlock x:Name="TagPickerTitle" Text="TAG CLIP" Style="{StaticResource H2}" />
                        <UniformGrid x:Name="TagButtons" Columns="4" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
